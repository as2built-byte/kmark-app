rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'a.matassa@kmark.it',
          'a.atamna@kmark.it'
        ];
    }

    // ── timbrature ────────────────────────────────────────────────────────────
    // Each employee can write their own stamps and read their own records.
    // Admins can read all records (needed for TimbratureAdmin view).
    match /timbrature/{docId} {
      allow create: if isAuth() &&
                       request.resource.data.userId == request.auth.uid;
      allow read:   if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false; // stamps are immutable
    }

    // ── dipendenti ────────────────────────────────────────────────────────────
    // All authenticated users can read (needed for name lookups everywhere).
    // Only admins can write.
    match /dipendenti/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── bustePaga ─────────────────────────────────────────────────────────────
    // Employees can read only their own payslips.
    // Admins can read all and write/delete.
    match /bustePaga/{docId} {
      allow read:   if isAuth() &&
                       (resource.data.emailDipendente == request.auth.token.email || isAdmin());
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ── spese ─────────────────────────────────────────────────────────────────
    // Employees manage their own expenses; admins can read all.
    match /spese/{docId} {
      allow read:   if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── presenze ──────────────────────────────────────────────────────────────
    // Employees manage their own absence requests; admins can read all.
    match /presenze/{docId} {
      allow read:   if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── bacheca ───────────────────────────────────────────────────────────────
    // All employees can read announcements; only admins can publish/delete.
    match /bacheca/{docId} {
      allow read:   if isAuth();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    // ── documenti ─────────────────────────────────────────────────────────────
    // Employees manage their own documents; admins can read all and upload for any employee.
    match /documenti/{docId} {
      allow read:   if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() &&
                       (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuth() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // ── cantieri ──────────────────────────────────────────────────────────────
    // All authenticated users can read sites; only admins can create/update/delete.
    match /cantieri/{docId} {
      allow read:   if isAuth();
      allow create,
            update,
            delete: if isAdmin();
    }
  }
}
